[Unit]
Description=Run PTO Task automatic update nightly when idle
After=time-sync.target

[Timer]
# Explicit timezone: independent of the server's local timezone. Calendar
# timers use the synchronized system clock; time-sync.target orders this after
# the host's configured NTP synchronization service when one is enabled.
OnCalendar=*-*-* 03:17:00 Asia/Shanghai
AccuracySec=1min
# Do not replay a missed nighttime update after a daytime boot.
Persistent=false
Unit=pto-task-auto-update.service

[Install]
WantedBy=timers.target

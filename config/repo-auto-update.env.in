# Local, root-owned configuration for repository-controlled pto-task rollouts.
# Preserve this file across application updates.
REPO_AUTO_UPDATE_NAME=pto-task
REPO_AUTO_UPDATE_REPOSITORY=https://github.com/pypto-tools/npu-taskqueue.git
REPO_AUTO_UPDATE_BRANCH=main
REPO_AUTO_UPDATE_MANIFEST=update/rollout.json
REPO_AUTO_UPDATE_STATE_DIR=@TOOL_ROOT@/update
REPO_AUTO_UPDATE_TMP_DIR=@TMP_DIR@
REPO_AUTO_UPDATE_TEST_USER=daemon
# Optional network identity for repository fetches. The defaults use root and
# the service's normal network environment; set both values when root has no
# direct egress. Do not put credentials in this non-secret file.
REPO_AUTO_UPDATE_FETCH_USER=root
REPO_AUTO_UPDATE_FETCH_ALL_PROXY=
REPO_AUTO_UPDATE_VERIFY=@APP_DIR@/pto-task-repo-update-verify
REPO_AUTO_UPDATE_APPLY=@APP_DIR@/pto-task-repo-update-apply
REPO_AUTO_UPDATE_LOCK_FILE=/run/lock/pto-task-repo-auto-update.lock

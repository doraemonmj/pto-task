[Unit]
Description=Task Queue Daemon (root executor)
After=network.target
RequiresMountsFor=/home/pypto-tools/pto-task/app

[Service]
Type=simple
ExecStart=/home/pypto-tools/pto-task/app/task-daemon
Restart=on-failure
RestartSec=5

# security
NoNewPrivileges=no
ProtectSystem=no
ProtectHome=no

[Install]
WantedBy=multi-user.target
# setup.sh maintains taskqueue.service as an alias of this unit.
